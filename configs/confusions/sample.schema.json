{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingo.local/schemas/confusion-sample.v1.json",
  "title": "Lingo common confusion sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "split",
    "kind",
    "user_strokes",
    "target_template",
    "written_char",
    "target_char",
    "competitor_char",
    "is_target",
    "quality_for_written_char",
    "target_match",
    "pair_id",
    "critical_strokes",
    "evidence_labels",
    "ambiguity",
    "seed",
    "morph_alpha"
  ],
  "properties": {
    "schema_version": {"const": "confusion_sample.v1"},
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,255}$"
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test"]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "user_strokes": {"$ref": "#/$defs/strokes"},
    "target_template": {"$ref": "#/$defs/strokes"},
    "written_char": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 1},
        {"type": "null"}
      ]
    },
    "target_char": {"type": "string", "minLength": 1, "maxLength": 1},
    "competitor_char": {"type": "string", "minLength": 1, "maxLength": 1},
    "is_target": {"type": ["boolean", "null"]},
    "quality_for_written_char": {"$ref": "#/$defs/optional_score"},
    "target_match": {"$ref": "#/$defs/optional_score"},
    "pair_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,255}$"
    },
    "critical_strokes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 63}
    },
    "evidence_labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_code"}
    },
    "ambiguity": {"type": "boolean"},
    "seed": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        {"type": "null"}
      ]
    },
    "morph_alpha": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"ambiguity": {"const": true}},
        "required": ["ambiguity"]
      },
      "then": {
        "properties": {
          "written_char": {"type": "null"},
          "is_target": {"type": "null"},
          "quality_for_written_char": {"type": "null"},
          "evidence_labels": {
            "contains": {"const": "AMBIGUOUS_BETWEEN_CHARACTERS"}
          }
        }
      },
      "else": {
        "properties": {
          "written_char": {"type": "string", "minLength": 1, "maxLength": 1},
          "is_target": {"type": "boolean"},
          "evidence_labels": {
            "not": {
              "contains": {"const": "AMBIGUOUS_BETWEEN_CHARACTERS"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "stroke": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/point"}
    },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/stroke"}
    },
    "optional_score": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "evidence_code": {
      "type": "string",
      "enum": [
        "START_TOO_HIGH",
        "START_TOO_LOW",
        "START_TOO_LEFT",
        "START_TOO_RIGHT",
        "END_TOO_HIGH",
        "END_TOO_LOW",
        "STROKE_TOO_LONG",
        "STROKE_TOO_SHORT",
        "STROKE_TOO_VERTICAL",
        "STROKE_TOO_HORIZONTAL",
        "STROKE_ANGLE_MISMATCH",
        "CURVE_TOO_EARLY",
        "CURVE_TOO_LATE",
        "TERMINAL_HOOK_WRONG_DIRECTION",
        "INTER_STROKE_GAP_TOO_SMALL",
        "INTER_STROKE_GAP_TOO_LARGE",
        "CHARACTER_RESEMBLES_COMPETITOR",
        "AMBIGUOUS_BETWEEN_CHARACTERS"
      ]
    }
  }
}
